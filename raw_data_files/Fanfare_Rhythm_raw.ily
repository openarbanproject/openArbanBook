% Fanfare Style Studies

"fanfare 19" = \relative c' {
    \time 2/4
    \key c \major
    c'8-. c16-. c-. c8-. g-. e'-. e16-. e-. e8-. c-. g'8-. g16-. g-. g8-. e-. c4 r
    d8-"sim." d16 d d8 f e g d4 fs8 fs16 e d8 d16 c b8 a g4
    bf8 bf16 bf bf8 g ef'8 ef16 ef ef8 bf g'8 g16 g g8 ef bf4 r
    af8 af16 af f8 bf af af16 af f8 c' c b16 b bf8 af g4 r
    af8 af16 af f8 c' bf g16 bf ef4 ef8 ef16 ef d8 c g' g,16 g g8 g
    c8 c16 c c8 g e' e16 e e8 c g' g16 g g8 e c4 r
    a8 a16 a a8 b16 c d8 e f4 g,8 b16 d g8 b, c e c r \bar "|." }

"fanfare 20" = \relative c' {
    \time 2/4
    \key c \major
    c'8-. c16-. c-. c8-. e16-. c-. g8-. g16-. g-. g8-. c16-. d-. e8-. e16-. e-. e8-. g16-. e-. c4-. r
    c8-"sim." c16 c c8 e16 c a8 a16 a a8 b16 c d8 c16 c b8 a16 a gs4 r
    a8 a16 a a8 b16 c d8 d16 d d8 c16 d e8 e16 e e8 d16 c b4 r
    g'8 g16 g g8 f16 f e8 d16 d c8 b16 b a8 b16 c d8 e16 fs g4 r
    c,8 c16 c c8 e16 c g8 g16 g g8 c16 d e8 e16 e e8 g16 e c4 r8 b16 c
    d8 d16 c b8 b16 a g8 g'16 g f8 e d b16 d g8 b, c4 r \bar "|." }

"fanfare 21" = \relative c' {
    \time 2/4
    \key f \major
    c'16->-. c-. c8-. a-. c-. f16->-. f-. f8-. e-. d-.
    c16->-. c-. c8-. bf-. a-. c16->-. bf-. g8-. r4
    c16->-. c-. c8 d16->-. d-. d8-. e16->-. e-. e8-. f16->-. f-. f8-.
    e16-. e-. e8-. d16-. d-. d8-. c16-. c-. e8-. c-. r \bar "||"

    d16 d d8 g, bf a16 a a8 cs e d16 d d8 f d a4 r
    gs16 gs gs8 e' gs, a16 a a8 e' a, gs16 gs gs8 a c e4 r
    c16 c c8 a c f16 f f8 e d c16 c c8 bf a c16 bf g8 r4
    d'16 d d8 e16 e e8 f16 f f8 a,16 a a8 d16 d d8 c16 c c8 f,16 f a8 f r \bar "|." }

"fanfare 22" = \relative c' {
    \time 2/4
    \key f \major
    c'16-. a-. f8-. c'16-. a-. f8-. g-. c,-. c'16-. d-. c8-.
    bf16-. g-. e8-. bf'16-. g-. e8-. g-. c,-. a'16-. bf-. a8-.
    c16-"sim." a f8 c'16 a f8 g c, c'16 d c8 b16 c d8 g, g' c, e,16 g c8 r
    bf16 a g8 bf d c16 bf a8 c f f16 f e8 d16 d c8 bf16 bf a8 g4
    bf16 a g8 bf d c16 bf a8 c f af,16 f c8 f af c4 r \bar "||"
    c16 a f8 c'16 a f8 g c, c'16 d c8  bf16 g e8 bf'16 g e8 g c, a'16 bf a8
    c16 a f8 c'16 a f8 g c, c'16 d c8 bf16 a g8 c e, f a16 c f8 r \bar "|." }

"fanfare 23" = \relative c' {
    \time 2/4 \partial 8
    \key g \major
    g'16-. a-.
    b-.-> b-. b-. r  b-.[ r a-. g-.] d-.-> d-. d-. r d-.[ r g-. a-.]
    b-.-> b-. b-. r b-.[ r e-. d-.] d-.-> d-. cs-. r c-.[ r a-. b-.]
    c-"sim." c c r c[ r b a] d, d d r d[ r fs a] d d d r d[ r cs c]  b b b r b[ r b a]
    gs gs gs r b[ r e d] c c c r c[ r a g]  fs fs fs r a[ r d c ] b b b r b[ r g a]
    bf bf bf r bf[ r  a g]  ef ef ef r ef[ r d cs] d d d r d[ r fs a] d d d r d[ r cs c]
    b  b b r  b[ r a g] d d d r d[ r g a]  b b b r b[ r e d] d d cs r c[ r a b]
    c c c r c[ r b a] e' e e r ef[ r d cs] d d d r c[ b a] a a a r g8 \bar "|." }

"fanfare 24" = \relative c' {
    \time 2/4
    \key g \major
    g'-^ b16-. b-. b-. b-. e8-. d-. a4-^ b-^ d16-. d-. d-. d-. g8-. fs-. c4-^
    b4-"sim." d16 d d d a'8 g fs4 a, cs16 cs cs cs fs8 e d4
    d16 c a8 d16 c a8 b4 e16 e e e d16 c a8 d16 c a8 b4 b16 b b b
    b8 gs b e ds4 fs16 fs fs fs ds8b a fs e4 e'16 e e e
    c c e8 b16 b e8 a, e'16 e gs,8 e'16 e a, a e'8 c16 c e8 b4 e16 e e e
    e e c8 e16 e e e e e a,8 e'16 e e e d8 c16 c b b a8 e'4 g,16 g g g
    g8 e' g, f' e4 a,16 a a a a8 f' gs, f' e4 ds16 ds ds ds
    e4 ds16 ds ds ds e8 f16 f e e ds8 e fs16 fs e e ds8 d16 d c8 b a
    g4 b16 b b b e8 d a4 b d16 d d d g8 fs c4
    b4 d16 d d d a'8 g e4 a, c16 c c c e8 d g, r \bar "|." }

"fanfare 25" = \relative c' {
    \time 2/4
    \key c \major
    c'8-. c16-. c-. c-. c-. c-. c-. b-. b-. a8-. g16-. g-. g8-.
    d'16-. d-. d-. d-. d-. d-. d8-. f-. e16-. e-. d-. d-. e8-.
    c8-"sim." c16 c c c c c b b a8 gs16 gs gs8 d'8 d16 d c c b8 a16 a a c e e e8
    ds8 ds16 ds ds ds ds ds e e e8 gs16 gs e8 fs16 fs fs fs fs e ds8 cs b gs' e
    cs8 cs16 cs cs e ds8 ds16 ds ds ds ds fs e8 ds ds16 ds cs cs b8 as a16 a gs gs gs8
    fs16 fs a a cs cs cs8 b gs16 gs b b e e ds ds b8 a16 a fs fs e4 r16 e f fs
    g8 c16 c e e g8 g, b16 b d d g g fs e d8 c16 b a8 g g16 g g g g g
    c8 c16 c c c c c b b a8 g16 g g8 d'16 d d d d d d8 f e16 e d d e8
    c16 c c c c c c8 a16 a a8 af16 af af af g c e8 f,16 g d'8 e,16 g c e c8 r \bar "|." }

"fanfare 26" = \relative c'' {
    \time 2/4
    \key g \major
    g4-^ b16-. b-. b-. b-. | e8-. d-. a4-^          |
    b-^ d16-. d-. d-. d-.  | g8-. fs-. c4-^         | % added staccato for consistency
    b-"sim." d16 d d d     | a'8 g fs4              |
    a, cs16 cs cs cs       | fs8 e d4               |
    d16 c a8 d16 c a8      | b4 e16 e e e           |
    d c a8 d16 c a8        | b4 b16 b b b           |
    b8 gs b e              | ds4 fs16 fs fs fs      |
    ds8 b a fs             | e4 e'16 e e e          |
    c c e8 b16 b e8        | a,8 e'16 e gs,8 e'16 e |
    a,16 a e'8 c16 c e8    | b4 e16 e e e           |
    e16 e c8 e16 e e e     | e16 e a,8 e'16 e e e   |
    d8 c16 c b b a8        | e'4 g,16 g g g         |
    g8 e' g, f'            | e4 a,16 a a a          |
    a8 f' gs, f'           | e4 ds16 ds ds ds       |
    e4 ds16 ds ds ds       | e8 f16 f e e ds8       |
    e8 fs16 fs e e ds8     | d16 d c8 b a           |
    g4 b16 b b b           | e8 d a4                |
    b d16 d d d            | g8 fs c4               |
    b d16 d d d            | a'8 g fs4              |
    a, cs16 c c c          | e8 d c4          \bar "|." }

"fanfare 27" = \relative c'' {
    \time 2/4
    \key c \major
    c8 c16 c c c c c       | b b a8 g16 g g8        |
    d'16 d d d d d d8      | f8 e16 e d d e8        |
    c c16 c c c c c        | b b a8 gs16 gs gs8     |
    d' d16 d c c b8        | a16 a a c e e e8       |
    ds ds16 ds ds ds ds ds | e e e8 gs16 gs e8      |
    fs16 fs fs fs fs e ds8 | cs8 b gs' e            |
    cs cs16 cs cs e ds8    | ds16 ds ds ds ds fs e8 |
    ds8 ds16 ds cs cs b8   | as8 a16 a gs gs gs8    |
    fs16 fs a a cs cs cs8  | b gs16 gs b b e e      |
    ds ds b8 a16 a fs fs   | e4 r16 e f fs          | \break
    g8 c16 c e e g8        | g,16 g b b d d g8      |
    b,16 c d8 e f          | e16 e e c g8 g16 g     |
    g g c c e e g8         | g,8 b16 b d d g g      |
    fs e d8 c16 b a8       | g8 g16 g g g g g       |
    c8 c16 c c c c c       | b b a8 g16 g g8        |
    d'16 d d d d d d8      | f8 e16 e d d e8        |
    c16 c c c c c c8       | a16 a a8 af16 af af af |
    g c e8 f,16 g d'8      | e,16 g c e c8 r  \bar "|." }
