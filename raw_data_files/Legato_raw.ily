    g8( b)    \tuplet 3/2 {d16[( f d})]     \tuplet 3/2 {b16( d b})
    g16 b d, f    g b d g,
    c8 	\tuplet 3/2 {e16( g e}) c8 \tuplet 3/2 {e16( g e})
